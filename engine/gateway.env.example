# Copy to engine/gateway.env (chmod 600). All optional; never commit the real file.

# Posting: set the key of the service your accounts use (see gateway/posting.py).
# Upload-Post (upload-post.com):
UPLOAD_POST_API_KEY=
# Postiz cloud, or a self-hosted Postiz (then POSTIZ_URL=https://<host>/api/public/v1):
POSTIZ_API_KEY=
POSTIZ_URL=
# Web app address, for download links of clips marked "post by hand" (optional):
APP_URL=

# Telegram pings: new clips to review, links after a post (submit them to the
# campaign within its deadline). Without them the gateway just logs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
