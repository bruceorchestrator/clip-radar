# Copy to engine/.env (chmod 600). Read by the OpenShorts core and, for the brief
# importer, by the gateway (LLM_BASE_URL / LLM_API_KEY). Never commit the real file.

# Any OpenAI-compatible endpoint. OpenRouter lets you pick a cheap model.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
# Picks moments, scores them, writes hook/title. Cheap and good enough.
LLM_MODEL=google/gemini-3.5-flash-lite

# Speech to text runs locally in the core (free). "base" on CPU is fast enough;
# under loud music it misses words (then use a headline instead of captions).
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

FFMPEG_ENCODER=x264
LLM_SCORE_BATCH=8
CLIP_MIN_SECONDS=15
CLIP_MAX_SECONDS=45
# A 2-core server: one job at a time.
CLIP_WORKERS=1
MAX_CONCURRENT_JOBS=1
